# ============================================
# MUZAPP — Environment Variables
# ============================================
# Copy this file to .env.local for development.
# On Render: add these in your service's Environment tab.
#
# ✅ REQUIRED for a functional deploy: DATABASE_URL, AUTH_SECRET, AUTH_URL,
#    NEXT_PUBLIC_APP_URL (and NODE_VERSION on Render).
# Everything else is optional or can be configured later from the admin UI
# (/admin/agent → "Integraciones") — business identity, WhatsApp/YCloud, AI,
# Cloudinary, Meta, Telegram and cron credentials all persist in the database.
# DB values take precedence over these env vars.
#
# FIRST ACCESS: open /setup in the browser — it creates the first admin with a
# single atomic insert and works only while `users` is empty (afterwards it
# redirects to /login). For unattended provisioning use `npm run db:seed`
# with ADMIN_EMAIL / ADMIN_PASSWORD set (below) — it never creates default
# credentials.

# ─── Core (required) ──────────────────────────────────────────────────────────
# Picked up by Render to select the Node runtime (package.json has no engines
# field). Keep it pinned — the blueprint relies on it.
NODE_VERSION=20

# PostgreSQL connection string — MUST be a Neon database: the app uses the
# neon-http driver, so Render Postgres / RDS / Supabase / plain local Postgres
# will not connect.
# Use the POOLED connection string (host contains "-pooler.") for the app's
# DATABASE_URL; use the DIRECT endpoint (no "-pooler") when running
# `npm run db:migrate` — pooled connections don't support migration session state.
DATABASE_URL=postgresql://user:pass@host-pooler.region.neon.tech/dbname?sslmode=require

# NextAuth v5 — generate with: openssl rand -base64 32
# Also used to sign attribution links and encrypt stored credentials.
# NEVER rotate without a re-encryption plan — it derives the AES-256-GCM key
# that encrypts every credential stored in agent_config.
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Full public URL of the app (needed for OAuth callbacks + origin checks)
AUTH_URL=https://your-service.onrender.com
# Legacy NextAuth v4 aliases — the code still reads them as fallbacks for
# AUTH_SECRET / AUTH_URL (encryption, ref-code signing, checkout origin). Do
# not set on new installs; keep only for migrated deployments.
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=

# Public origin used for checkout origin checks and generated links.
# NEXT_PUBLIC_* vars are inlined at build time and visible to browsers —
# never put secrets in them.
NEXT_PUBLIC_APP_URL=https://your-service.onrender.com

# ─── First admin user (npm run db:seed only) ─────────────────────────────────
# Used ONLY by `npm run db:seed`. There are no default credentials.
# Interactive installs can skip this — /setup creates the first admin in the
# browser once the schema exists (see FIRST ACCESS note above).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: load the demo product catalog
# SEED_DEMO=1

# ─── Platform-provided (informational — do NOT set these yourself) ───────────
# Render/Next.js inject these at runtime; the app reads them as fallbacks.
# They are listed commented out on purpose — documenting them does NOT mean
# you should load your own values.
# Render assigns the port (default 10000); `next start` binds to it automatically.
# PORT=10000
# "production" on Render builds/starts; switches log level, cookie Secure flag,
# and checkout origin strictness. Set by the toolchain, not by you.
# NODE_ENV=production
# "nodejs" inside the Next server; gates the instrumentation boot hooks.
# NEXT_RUNTIME=nodejs
# Injected by Render; last-resort public-URL fallback after
# NEXT_PUBLIC_APP_URL / AUTH_URL. (RENDER_EXTERNAL_HOSTNAME is also injected
# but the app does not read it.)
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
# Legacy platform signal read as a final public-URL fallback. Irrelevant on
# Render — listed so the fallback order is complete.
# VERCEL_URL=your-app.vercel.app
# Injected by npm scripts; shown by /api/health. Never set manually.
# npm_package_version=0.1.0
# render.yaml sets this to --max-old-space-size=8192 so `next build` does not
# OOM on small instances; set it locally only if your build runs out of heap.
# NODE_OPTIONS=--max-old-space-size=8192

# ─── WhatsApp via YCloud (optional — settable from /admin/agent) ──────────────
# These env vars act as bootstrap; the admin UI values take precedence.
# YCLOUD_API_KEY=replace-with-ycloud-api-key
# YCLOUD_WEBHOOK_SECRET=secret-you-also-set-in-ycloud-dashboard
# WHATSAPP_PHONE_NUMBER=5491112345678   # digits only, no +

# ─── Unified provider ingress (Zernio / Kapso — registered adapters) ─────────
# POST /api/webhooks/ingress/<provider> verifies with a per-provider secret:
# ycloud uses YCLOUD_WEBHOOK_SECRET (above); zernio/kapso read
# <PROVIDER>_WEBHOOK_SECRET from env — OR the matching scoped credential in
# the agent_config chain (admin → agente → Integraciones / per-account scope).
# ZERNIO_WEBHOOK_SECRET=secret-you-set-in-zernio-webhook-settings
# KAPSO_WEBHOOK_SECRET=secret-from-kapso-dashboard
#
# Channel accounts (admin → Canales) reference credentials by ref:
# `env:PREFIX` resolves PREFIX+API_KEY / PREFIX+ACCESS_TOKEN /
# PREFIX+WEBHOOK_SECRET at send time — credentials stay out of the DB.
# Use a trailing underscore: credentialsRef "env:ZERNIO_" reads ZERNIO_API_KEY;
# "env:ZERNIO_MAIN_" reads ZERNIO_MAIN_API_KEY for a second account.
# `agent_config` (or empty) resolves the scoped agent_config fields instead —
# per-account > per-channel > global row, then <PROVIDER>_* env scope as last
# resort (e.g. KAPSO_API_KEY below).
# ZERNIO_API_KEY=zrn_live_replace_me
# ZERNIO_ACCESS_TOKEN=   # optional; unused today, reserved
# Zernio embedded connect (/admin/channels → "Conexión rápida con Zernio")
# uses ZERNIO_API_KEY + the public URL to round-trip OAuth/Embedded Signup.
# Full setup runbook (embedded + manual modes): docs/socialcrm/zernio-setup-runbook.md
# ZERNIO_PROFILE_ID=   # optional; defaults to your first (default) profile
#
# Kapso credentials — only needed when a Kapso channel account resolves
# through env scope (credentialsRef "env:KAPSO_" or the provider env-scope
# fallback). Scoped agent_config fields are the recommended alternative.
# KAPSO_API_KEY=replace-with-kapso-api-key
# KAPSO_ACCESS_TOKEN=   # optional; Meta access token when using Kapso Graph proxy

# ─── AI provider (optional — also settable from /admin/agent) ─────────────────
# Any OpenAI-compatible provider: OpenAI, OpenRouter, DeepSeek, Groq,
# Together, Ollama... Set the base URL + key + model names the provider expects.
# OPENAI_API_KEY=sk-replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-5.4-mini            # main WhatsApp sales agent
# AI_MODEL_FAST=gpt-5-mini         # internal agent + Telegram bot
# AI_MODEL_VISION=gpt-4o           # image analysis (needs a vision-capable model)
# NOTE: audio transcription uses {OPENAI_BASE_URL}/audio/transcriptions
# (Whisper-compatible endpoint). Providers without it just return null.
#
# Provider-aware env fallbacks — used when agent_config.ai_provider is set
# (catalog id or custom) but the row's key/URL fields are empty:
# AI_PROVIDER=deepseek                       # provider id for the env path
# AGENT_AI_API_KEY=replace-me                # generic key fallback
# AGENT_AI_<PROVIDER>_API_KEY=...            # per-provider key, e.g. AGENT_AI_DEEPSEEK_API_KEY
# AGENT_AI_BASE_URL=https://...              # generic base URL fallback
# AGENT_AI_<PROVIDER>_BASE_URL=https://...   # per-provider base URL
# Resolution order: agent_config row → AGENT_AI_<PROVIDER>_* → AGENT_AI_* →
# OPENAI_* → catalog default base URL.

# Extra hostnames the WhatsApp sendImage tool may send media from
# (comma-separated). Same-origin hosts and admin-configured media
# (product/menu image URLs) are always allowed; everything else is blocked.
# WHATSAPP_MEDIA_ALLOWED_HOSTS=cdn.example.com,res.cloudinary.com

# ─── Image uploads — Cloudinary (optional — also settable from /admin/agent) ──
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
# CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# ─── Inbound media (private — NOT under public/) ──────────────────────────────
# Customer media (WhatsApp/Telegram voice notes, photos, docs) is stored OUTSIDE
# public/ and served only through the session-gated /api/media/[...path] route.
# Default is data/uploads (relative to the app dir). On Render point this at a
# persistent disk mount (e.g. /var/data/uploads) — public/ and the ephemeral
# disk do not survive redeploys.
# MEDIA_UPLOADS_DIR=/var/data/uploads

# ─── Telegram internal bot (optional) ─────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=token-from-@BotFather
# Random secret embedded in the webhook URL: /api/telegram/webhook/<token>
# Generate with: openssl rand -hex 20
# TELEGRAM_WEBHOOK_TOKEN=replace-with-random-string
# Chat IDs allowed to use the internal bot (comma-separated). Empty = nobody.
# TELEGRAM_ALLOWED_CHAT_IDS=123456789
# Chat ID that receives order/escalation notifications
# (also settable from /admin/agent as "Telegram — Chat ID de avisos").
# TELEGRAM_LICHAS_CHAT_ID=123456789

# ─── Meta Ads — attribution + pixel (optional — app creds also in /admin/agent)
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=replace-with-meta-app-secret
# META_WEBHOOK_VERIFY_TOKEN=replace-with-random-string-for-webhook-verification
# NEXT_PUBLIC_META_PIXEL_ID=your-pixel-id           # fbq tracking (client-side, non-secret)

# ─── Facebook login provider (optional) ───────────────────────────────────────
# FACEBOOK_CLIENT_ID=your-facebook-app-id
# FACEBOOK_CLIENT_SECRET=replace-with-facebook-app-secret

# ─── Upstash Redis (optional but recommended for production) ──────────────────
# Without it, the agent buffer, DLQ and rate limits run in-memory (lost on
# redeploys). With it, they persist across instances.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token

# ─── Cron + escalations (optional — also settable from /admin/agent) ──────────
# Secret gating /api/cron/* (followup + reconcile) — the render.yaml blueprint
# auto-generates it. Cron routes call with POST + `Authorization: Bearer
# <secret>` (never in the URL, so it stays out of logs). DB value wins over env.
# Generate with: openssl rand -hex 32
# CRON_SECRET=replace-with-random-string
# Escape hatch for schedulers that can't send headers: with
# CRON_ALLOW_QUERY_KEY=1 the cron routes also accept the legacy `?key=`
# query-string secret. Leave it unset — the header-only default is the
# secure path and this is only a fallback.
# CRON_ALLOW_QUERY_KEY=1
# Recipient shown in escalation flows when the agent hands off to a human.
# ESCALATION_EMAIL=owner@example.com

# Display name used in human-hand-off messages (read by src/lib/whatsapp/agent.ts).
# BUSINESS_OWNER_NAME=Your Name
# Fallback business name when agent_config has none yet
# (read by src/lib/business.ts — DB value takes precedence once configured).
# BUSINESS_NAME=Mi Negocio
# Display-only opening hours line for the storefront (e.g. the home delivery
# block). The agent_config business hours configured from /admin/agent take
# precedence; this env is the fallback when no schedule exists.
# BUSINESS_HOURS=Lunes a Sábado · 10:00 a 22:00

# ─── Internal scheduler (optional) ────────────────────────────────────────────
# INTERNAL_CRON=1 enables the in-process reconcile scheduler at boot
# (src/instrumentation.ts) — for always-on instances. The Render cron jobs in
# render.yaml are the default; enabling both would double-run reconciles.
# INTERNAL_CRON=1
